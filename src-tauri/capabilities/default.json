{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Local RAMOpt window APIs. Privileged cleanup remains behind fixed Rust commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "core:event:default",
    "allow-get-app-state",
    "allow-save-settings",
    "allow-restore-defaults",
    "allow-clean-now",
    "allow-hide-window",
    "allow-install-update"
  ]
}
