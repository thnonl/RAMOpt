import { Button, CheckBox, ComboBox, SpinBox, VerticalBox, Palette } from "std-widgets.slint";

export component MainWindow inherits Window {
    in-out property <bool> auto-clean: true;
    in-out property <int> interval-minutes: 15;
    in-out property <string> hotkey: "ctrl+alt+KeyR";
    in-out property <bool> clean-temp: true;
    in-out property <bool> close-apps: true;
    in-out property <bool> startup: false;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> dark-mode: false;
    in-out property <string> current-version: "";
    in-out property <string> update-version: "";
    in-out property <string> status: "Ready.";
    in-out property <string> logs: "";

    init => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    changed dark-mode => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }

    callback save-settings();
    callback restore-defaults();
    callback clean-now();
    callback update-now();
    callback hide-window();

    title: "RAMOpt";
    width: 580px;
    height: root.update-version != "" ? 646px : 570px;
    background: root.dark-mode ? #171b24 : #f7f8fc;

    VerticalLayout {
        padding: 28px;
        spacing: 14px;

        HorizontalLayout {
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "RAMOpt";
                    font-size: 30px;
                    font-weight: 700;
                    color: root.dark-mode ? #f3f6fc : #182033;
                }
                Text {
                    text: "Installed version " + root.current-version;
                    font-size: 11px;
                    font-weight: 500;
                    color: root.dark-mode ? #9eabc0 : #778399;
                }
            }
            Rectangle {
                width: 66px;
                height: 28px;
                border-radius: 14px;
                background: root.dark-mode ? #40506b : #cbd3e1;
                Text {
                    text: root.dark-mode ? "DARK" : "LIGHT";
                    x: root.dark-mode ? 5px : 29px;
                    y: 0px;
                    width: 32px;
                    height: parent.height;
                    color: root.dark-mode ? #dce6f7 : #34445e;
                    font-size: 8px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                Rectangle {
                    width: 22px;
                    height: 22px;
                    x: root.dark-mode ? 41px : 3px;
                    y: 3px;
                    border-radius: 11px;
                    background: root.dark-mode ? #eef3fc : #ffd35a;
                }
                TouchArea { clicked => { root.dark-mode = !root.dark-mode; root.save-settings(); } }
            }
        }
        Text {
            text: root.close-to-tray ? "Lightweight RAM maintenance. Closing this window keeps RAMOpt in tray." : "Lightweight RAM maintenance.";
            color: root.dark-mode ? #b8c1d4 : #697386;
            wrap: word-wrap;
        }

        Rectangle {
            visible: root.update-version != "";
            height: 62px;
            border-radius: 8px;
            background: root.dark-mode ? #1d342d : #e4f5ec;
            border-width: 1px;
            border-color: root.dark-mode ? #2d6b55 : #a9dcc4;
            HorizontalLayout {
                padding: 10px;
                spacing: 12px;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Update available";
                        font-size: 12px;
                        font-weight: 700;
                        color: root.dark-mode ? #8fe0b5 : #176b45;
                    }
                    Text {
                        text: root.update-version + " is ready. You have " + root.current-version + ".";
                        font-size: 10px;
                        color: root.dark-mode ? #c1d8cc : #39705a;
                    }
                }
                Button {
                    text: "Install " + root.update-version;
                    primary: true;
                    clicked => { root.update-now(); }
                }
            }
        }

        Rectangle { height: 1px; background: root.dark-mode ? #353d4d : #dfe3eb; }

        VerticalBox {
            spacing: 10px;
            CheckBox { text: "Enable scheduled cleanup"; checked: root.auto-clean; toggled => { root.auto-clean = self.checked; root.save-settings(); } }
            HorizontalLayout {
                spacing: 12px;
                Text { text: "Interval (minutes)"; vertical-alignment: center; color: root.dark-mode ? #e1e7f2 : #343d4f; }
                SpinBox { value: root.interval-minutes; minimum: 1; maximum: 1440; edited => { root.interval-minutes = self.value; root.save-settings(); } }
            }
            HorizontalLayout {
                spacing: 12px;
                Text { text: "Global hotkey"; vertical-alignment: center; color: root.dark-mode ? #e1e7f2 : #343d4f; }
                ComboBox {
                    model: ["Ctrl + Alt + R", "Ctrl + Alt + M", "Ctrl + Shift + R", "Ctrl + Shift + M", "Alt + R", "Alt + M"];
                    current-value: root.hotkey == "ctrl+alt+KeyM" ? "Ctrl + Alt + M" : root.hotkey == "ctrl+shift+KeyR" ? "Ctrl + Shift + R" : root.hotkey == "ctrl+shift+KeyM" ? "Ctrl + Shift + M" : root.hotkey == "alt+KeyR" ? "Alt + R" : root.hotkey == "alt+KeyM" ? "Alt + M" : "Ctrl + Alt + R";
                    selected => {
                        root.hotkey = self.current-value == "Ctrl + Alt + M" ? "ctrl+alt+KeyM" : self.current-value == "Ctrl + Shift + R" ? "ctrl+shift+KeyR" : self.current-value == "Ctrl + Shift + M" ? "ctrl+shift+KeyM" : self.current-value == "Alt + R" ? "alt+KeyR" : self.current-value == "Alt + M" ? "alt+KeyM" : "ctrl+alt+KeyR";
                        root.save-settings();
                    }
                }
            }
            CheckBox { text: "Clean user temp files"; checked: root.clean-temp; toggled => { root.clean-temp = self.checked; root.save-settings(); } }
            CheckBox { text: "Close selected user apps (safe)"; checked: root.close-apps; toggled => { root.close-apps = self.checked; root.save-settings(); } }
            CheckBox { text: "Start with Windows"; checked: root.startup; toggled => { root.startup = self.checked; root.save-settings(); } }
            CheckBox { text: "Close to tray icon"; checked: root.close-to-tray; toggled => { root.close-to-tray = self.checked; root.save-settings(); } }
        }

        HorizontalLayout {
            spacing: 12px;
            Button { text: "Default"; clicked => { root.restore-defaults(); } }
            Button { text: "Clean RAM now"; primary: true; clicked => { root.clean-now(); } }
        }

        Rectangle {
            height: 94px;
            border-radius: 8px;
            background: root.dark-mode ? #252d3d : #e9eef9;
            clip: true;
            VerticalLayout {
                padding: 8px;
                spacing: 3px;
                Text { text: root.status; color: root.dark-mode ? #f5f8ff : #17233a; font-size: 12px; font-weight: 500; overflow: elide; }
                Text { text: root.logs == "" ? "No cleanup logs yet." : root.logs; color: root.dark-mode ? #cdd6e7 : #4a5870; font-size: 10px; wrap: word-wrap; overflow: elide; }
            }
        }
    }
}
